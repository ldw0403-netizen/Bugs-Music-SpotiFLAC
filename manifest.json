{
  "name": "bugs-music",
  "displayName": "Bugs Music",
  "version": "1.1.0",
  "description": "Bugs Music metadata provider with chart, latest music, search, and Home Feed support.",
  "author": "ldw0403-netizen",
  "homepage": "https://github.com/ldw0403-netizen/Bugs-Music-SpotiFLAC",
  "icon": "icon.png",
  "permissions": {
    "network": [
      "music.bugs.co.kr",
      "*.bugs.co.kr"
    ],
    "storage": false,
    "file": false
  },
  "type": [
    "metadata_provider"
  ],
  "capabilities": {
    "homeFeed": true
  },
  "skipMetadataEnrichment": false,
  "skipBuiltInFallback": false
}
