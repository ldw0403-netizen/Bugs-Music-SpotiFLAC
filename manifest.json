{
  "name": "bugs-music",
  "displayName": "벅스뮤직",
  "version": "1.1.3",
  "description": "Bugs Music metadata/search provider for SpotiFLAC Mobile.",
  "author": "Community",
  "homepage": "https://music.bugs.co.kr",
  "permissions": {
    "network": [
      "music.bugs.co.kr",
      "api.song.link"
    ],
    "storage": true
  },
  "type": [
    "metadata_provider"
  ],
  "skipMetadataEnrichment": false,
  "skipBuiltInFallback": false,
  "searchBehavior": {
    "enabled": true,
    "primary": false,
    "placeholder": "벅스뮤직 검색...",
    "thumbnailRatio": "square",
    "filters": [
      {
        "id": "track",
        "label": "곡"
      },
      {
        "id": "album",
        "label": "앨범"
      },
      {
        "id": "artist",
        "label": "아티스트"
      }
    ]
  }
}